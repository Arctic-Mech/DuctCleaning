rules_version = '2';

// Duct Cleaning field app — NO AUTH.
// Anyone who can reach the app can upload/read plan PDFs and photos.
// Paste this into: Firebase console → Storage → Rules → Publish.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
